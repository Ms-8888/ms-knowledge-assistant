# Used by docker compose. The defaults work as-is for a local demo.
POSTGRES_PASSWORD=postgres
# Opens the Beheer tab. Set your own value; while it is empty the admin view is switched off.
ADMIN_KEY=
# Answer mode: extractive (default, no model) | ollama | anthropic. See README.
LLM_BACKEND=extractive
# OLLAMA_MODEL=qwen2.5:7b
# ANTHROPIC_API_KEY=
